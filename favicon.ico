<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <!-- Background: Deep Navy Rounded Square -->
  <rect width="512" height="512" rx="112" fill="#1e3a5f"/>
  
  <!-- Subtle inner border ring -->
  <rect x="16" y="16" width="480" height="480" rx="96" fill="none" stroke="#E8600A" stroke-width="8" stroke-opacity="0.3"/>

  <!-- Chimney -->
  <rect x="330" y="140" width="40" height="80" rx="6" fill="#E8600A"/>

  <!-- House Body (White) -->
  <path d="M140 230 L256 130 L372 230 V384 C372 395 363 404 352 404 H160 C149 404 140 395 140 384 Z" fill="#FFFFFF"/>

  <!-- House Roof (Orange) -->
  <path d="M256 96 L420 232 C426 237 426 246 420 251 L404 264 C398 269 389 268 384 262 L256 158 L128 262 C123 268 114 269 108 264 L92 251 C86 246 86 237 92 232 Z" fill="#E8600A"/>

  <!-- Calculator Screen (Navy) -->
  <rect x="186" y="240" width="140" height="36" rx="8" fill="#1e3a5f"/>
  <!-- Screen LED bars / numbers indicator -->
  <rect x="200" y="252" width="40" height="12" rx="3" fill="#E8600A"/>
  <rect x="286" y="252" width="26" height="12" rx="3" fill="#FFFFFF"/>

  <!-- Calculator Buttons (Orange & Navy) -->
  <!-- Row 1 -->
  <rect x="186" y="292" width="38" height="34" rx="8" fill="#E8600A"/>
  <rect x="237" y="292" width="38" height="34" rx="8" fill="#1e3a5f"/>
  <rect x="288" y="292" width="38" height="34" rx="8" fill="#1e3a5f"/>

  <!-- Row 2 -->
  <rect x="186" y="338" width="38" height="34" rx="8" fill="#1e3a5f"/>
  <rect x="237" y="338" width="38" height="34" rx="8" fill="#E8600A"/>
  <rect x="288" y="338" width="38" height="34" rx="8" fill="#E8600A"/>
</svg>
